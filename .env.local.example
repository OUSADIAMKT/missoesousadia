# Copie este arquivo para `.env.local` (que já está no .gitignore) e preencha
# com os valores do seu projeto Supabase: Project Settings → API.
#
# A "anon public key" é segura para expor no navegador — o que protege os
# dados de verdade é a Row Level Security definida em supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI

# Recursos de IA (briefing do dia, rascunho de entrega, sugestão de cobrança,
# estimativa de missão, resumo de conversa, resumo executivo — ver
# src/app/api/ia/). SEM o prefixo NEXT_PUBLIC_ de propósito: essa chave só
# pode ser lida no servidor (Route Handlers); com NEXT_PUBLIC_ ela vazaria no
# bundle do navegador. Pegue a sua em console.anthropic.com.
ANTHROPIC_API_KEY=SUA-CHAVE-AQUI
